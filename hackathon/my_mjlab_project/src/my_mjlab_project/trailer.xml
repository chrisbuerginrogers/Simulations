<mujoco model="trailer">
  <compiler angle="radian"/>
  <option timestep="0.01"/>

  <default>
    <geom friction="1.0 0.005 0.0001"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" rgba="0.55 0.55 0.55 1"/>

    <!-- Visual-only marker for the parking spot. contype/conaffinity 0 means
         it never collides with anything -- it's just paint on the floor. -->
    <geom name="parking_spot" type="box" size="0.5 0.2 0.001" pos="0.8 0.8 0.001"
          rgba="0.2 0.8 0.2 0.35" contype="0" conaffinity="0"/>

    <!-- Link 1: tractor. Free to translate in x/y and rotate in yaw. -->
    <body name="tractor" pos="0 0 0.08">
      <joint name="tractor_x" type="slide" axis="1 0 0" damping="5"/>
      <joint name="tractor_y" type="slide" axis="0 1 0" damping="5"/>
      <joint name="tractor_yaw" type="hinge" axis="0 0 1" damping="2"/>

      <geom name="tractor_body" type="box" size="0.2 0.1 0.08" mass="5" rgba="0.8 0.2 0.2 1"/>

      <site name="tractor_front" pos="0.2 0 0" size="0.02"/>
      <site name="hitch_point" pos="-0.2 0 0" size="0.02"/>

      <!-- Link 2: trailer, attached behind the tractor via the hitch hinge. -->
      <body name="trailer" pos="-0.55 0 0">
        <joint name="hitch" type="hinge" axis="0 0 1" pos="0.35 0 0"
               range="-2.0944 2.0944" limited="true" damping="1"/>

        <geom name="trailer_body" type="box" size="0.3 0.12 0.08" mass="3" rgba="0.2 0.2 0.8 1"/>

        <site name="trailer_center" pos="0 0 0" size="0.02"/>
        <site name="trailer_rear" pos="-0.3 0 0" size="0.02"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="tractor_x_act" joint="tractor_x" kv="50" ctrllimited="true" ctrlrange="-1 1"/>
    <velocity name="tractor_y_act" joint="tractor_y" kv="50" ctrllimited="true" ctrlrange="-1 1"/>
    <velocity name="tractor_yaw_act" joint="tractor_yaw" kv="20" ctrllimited="true" ctrlrange="-1.57 1.57"/>
  </actuator>
</mujoco>
